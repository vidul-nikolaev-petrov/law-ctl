<script>
document.addEventListener("DOMContentLoaded", function () {
    const observer = new MutationObserver(translateSearchResults);

    observer.observe(document.body, {
        childList: true,
        subtree: true
    });
   
    function translateSearchResults() {
        const el = document.querySelector("#mdbook-searchresults-header");
        const engNoR = "No search results for";
        const engOneR = "1 search result for";

        if (el.textContent.startsWith(engNoR)) {
            el.textContent = el.textContent.replace(
                engNoR, "Няма намерени резултати за"
            );
        }

        else if (el.textContent.startsWith(engOneR)) {
            el.textContent = el.textContent.replace(
                engOneR, "Намерен е един резултат за"
            );
        }

        else if (/^\d+ search results/.test(el.textContent)) {
            el.textContent = el.textContent.replace(
                /^(\d+) search results for/,
                "Намерени са $1 резултата за"
            );
        }
    }
});
</script>

<script>
// Prefetch all pages
document.addEventListener("DOMContentLoaded", async () => {
    const ipv4Regex = /^(\d{1,3}\.){3}\d{1,3}$/;
    const hostname = window.location.hostname;
    const isIPv4 = ipv4Regex.test(hostname);

    if (isIPv4) {
        console.log(">>> ip4", hostname);
        return;
    }

    const links = [...document.querySelectorAll("a")];

    const pages = [...new Set(
        links
            .map(a => a.href)
            .filter(url =>
                url.startsWith(location.origin) &&
                url.endsWith(".html")
            )
    )];

    const prefetched = JSON.parse(
        sessionStorage.getItem("prefetchedPages") || "[]"
    );

    const done = new Set(prefetched);

    const missing = pages.filter(url => !done.has(url));

    await Promise.all(
        missing.map(async url => {
            await fetch(url, {
                credentials: "same-origin"
            });
            done.add(url);
        })
    );

    sessionStorage.setItem(
        "prefetchedPages",
        JSON.stringify([...done])
    );
});
</script>

